-- Create buttons
local AutoTapButton = CreateToggleButton("Auto Tap", UDim2.new(0, 0, 0, 0))
local AutoRebirthButton = CreateToggleButton("Auto Rebirth", UDim2.new(0, 0, 0, 40))
local AutoUpgradeButton = CreateToggleButton("Auto Upgrade", UDim2.new(0, 0, 0, 80))

-- Button click handlers
local function UpdateButton(button, enabled)
    button.Text = button.Name:gsub("Button", "")..": "..(enabled and "ON" or "OFF")
    button.BackgroundColor3 = enabled and Color3.fromRGB(75, 255, 75) or Color3.fromRGB(255, 75, 75)
end

AutoTapButton.MouseButton1Click:Connect(function()
    Config.AutoTap = not Config.AutoTap
    UpdateButton(AutoTapButton, Config.AutoTap)
end)

AutoRebirthButton.MouseButton1Click:Connect(function()
    Config.AutoRebirth = not Config.AutoRebirth
    UpdateButton(AutoRebirthButton, Config.AutoRebirth)
end)

AutoUpgradeButton.MouseButton1Click:Connect(function()
    Config.AutoUpgrade = not Config.AutoUpgrade
    UpdateButton(AutoUpgradeButton, Config.AutoUpgrade)
end)

-- Make frame draggable
local UserInputService = game:GetService("UserInputService")
local dragging
local dragInput
local dragStart
local startPos

local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

-- Main loop
spawn(function()
    while task.wait() do
        if Config.AutoTap then
            local AutoClickArgs = {
                [1] = true
            }
            game:GetService("ReplicatedStorage").Tap:InvokeServer(unpack(AutoClickArgs))
        end
    end
end)

spawn(function()
    while wait(1) do
        if Config.AutoRebirth then
            local RebirthArgs = {
                [1] = 500000
            }
            game:GetService("ReplicatedStorage").Rebirth:FireServer(unpack(RebirthArgs))
        end
    end
end)

spawn(function()
    while wait(0.2) do
        if Config.AutoUpgrade then
            local upgradeTypes = {
                "More Gems",
                "More Taps",
                "Luck",
                "Max Pets"
            }
            
            for _, upgradeType in ipairs(upgradeTypes) do
                local UpgradesArgs = {
                    [1] = upgradeType
                }
                game:GetService("ReplicatedStorage").Upgrade:InvokeServer(unpack(UpgradesArgs))
            end
        end
    end
end)
