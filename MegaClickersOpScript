-- Initialize configuration
local Config = {
    AutoTap = false,
    AutoRebirth = false,
    AutoUpgrade = false
}

-- Create the UI
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local UICorner = Instance.new("UICorner")
local Title = Instance.new("TextLabel")
local ButtonsHolder = Instance.new("Frame")
local UIListLayout = Instance.new("UIListLayout")

-- Function to create toggle buttons
local function CreateToggleButton(name, position)
    local Button = Instance.new("TextButton")
    Button.Name = name.."Button"
    Button.Size = UDim2.new(0.9, 0, 0, 30)
    Button.Position = position
    Button.Text = name..": OFF"
    Button.BackgroundColor3 = Color3.fromRGB(255, 75, 75)
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.Font = Enum.Font.GothamBold
    Button.TextSize = 14
    Button.Parent = ButtonsHolder
    
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 6)
    UICorner.Parent = Button
    
    return Button
end

-- Setup UI
ScreenGui.Parent = game.CoreGui
ScreenGui.Name = "TappingSimulatorGUI"

MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 200, 0, 180)
MainFrame.Position = UDim2.new(0.8, 0, 0.5, -90)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.Parent = ScreenGui

UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = MainFrame

Title.Name = "Title"
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundTransparency = 1
Title.Text = "Mega Clickers Script"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 16
Title.Parent = MainFrame

ButtonsHolder.Name = "ButtonsHolder"
ButtonsHolder.Size = UDim2.new(1, 0, 1, -40)
ButtonsHolder.Position = UDim2.new(0, 0, 0, 40)
ButtonsHolder.BackgroundTransparency = 1
ButtonsHolder.Parent = MainFrame

UIListLayout.Parent = ButtonsHolder
UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
