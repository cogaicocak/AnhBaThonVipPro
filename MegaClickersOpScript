-- Create buttons
local AutoTapButton = CreateToggleButton("Auto Tap", UDim2.new(0, 0, 0, 0))
local AutoRebirthButton = CreateToggleButton("Auto Rebirth", UDim2.new(0, 0, 0, 40))
local AutoUpgradeButton = CreateToggleButton("Auto Upgrade", UDim2.new(0, 0, 0, 80))

-- Button click handlers
local function UpdateButton(button, enabled)
    button.Text = button.Name:gsub("Button", "")..": "..(enabled and "ON" or "OFF")
    button.BackgroundColor3 = enabled and Color3.fromRGB(75, 255, 75) or Color3.fromRGB(255, 75, 75)
end

-- Function to start auto tap
local function startAutoTap()
    -- Clear any existing threads
    for _, thread in pairs(AllThreads) do
        if type(thread) == "thread" then
            task.cancel(thread)
        end
    end
    AllThreads = {}
    
    -- Create new threads
    for i = 1, 100 do
        local thread = task.spawn(function()
            while Config.AutoTap do
                if not Config.AutoTap then break end
                local RS = game:GetService("ReplicatedStorage")
                RS.Tap:InvokeServer(true)
                task.wait()
            end
        end)
        table.insert(AllThreads, thread)
    end
    
    -- Burst thread
    local burstThread = task.spawn(function()
        while Config.AutoTap do
            if not Config.AutoTap then break end
            for i = 1, 500000 do
                if not Config.AutoTap then break end
                task.spawn(function()
                    if not Config.AutoTap then return end
                    game:GetService("ReplicatedStorage").Tap:InvokeServer(true)
                end)
            end
            task.wait()
        end
    end)
    table.insert(AllThreads, burstThread)
end

AutoTapButton.MouseButton1Click:Connect(function()
    Config.AutoTap = not Config.AutoTap
    UpdateButton(AutoTapButton, Config.AutoTap)
    
    if Config.AutoTap then
        startAutoTap()
    else
        -- Stop all threads
        for _, thread in pairs(AllThreads) do
            if type(thread) == "thread" then
                task.cancel(thread)
            end
        end
        AllThreads = {}
        -- Force garbage collection
        task.wait()
        game:GetService("Debris"):AddItem(Instance.new("Folder"), 0)
    end
end)

AutoRebirthButton.MouseButton1Click:Connect(function()
    Config.AutoRebirth = not Config.AutoRebirth
    UpdateButton(AutoRebirthButton, Config.AutoRebirth)
end)

AutoUpgradeButton.MouseButton1Click:Connect(function()
    Config.AutoUpgrade = not Config.AutoUpgrade
    UpdateButton(AutoUpgradeButton, Config.AutoUpgrade)
end)

-- Make frame draggable
local UserInputService = game:GetService("UserInputService")
local dragging
local dragInput
local dragStart
local startPos

local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

-- Auto Rebirth
task.spawn(function()
    while true do
        if Config.AutoRebirth then
            local RebirthArgs = {
                [1] = 500000
            }
            game:GetService("ReplicatedStorage").Rebirth:FireServer(unpack(RebirthArgs))
        end
        task.wait(1)
    end
end)

-- Auto Upgrade
task.spawn(function()
    while true do
        if Config.AutoUpgrade then
            local upgradeTypes = {
                "More Gems",
                "More Taps",
                "Luck",
                "Max Pets"
            }
            
            for _, upgradeType in ipairs(upgradeTypes) do
                local UpgradesArgs = {
                    [1] = upgradeType
                }
                game:GetService("ReplicatedStorage").Upgrade:InvokeServer(unpack(UpgradesArgs))
            end
        end
        task.wait(0.2)
    end
end)

-- Add cleanup on script destruction
game:GetService("CoreGui").TappingSimulatorGUI.Destroying:Connect(function()
    Config.AutoTap = false
    Config.AutoRebirth = false
    Config.AutoUpgrade = false
    
    -- Cancel all threads
    for _, thread in pairs(AllThreads) do
        if type(thread) == "thread" then
            task.cancel(thread)
        end
    end
    AllThreads = {}
    
    -- Force cleanup
    task.wait()
    game:GetService("Debris"):AddItem(Instance.new("Folder"), 0)
end)
